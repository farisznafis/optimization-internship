# Copy to .env and fill in what you need. Every variable is optional.

# Gurobi Web License Service (WLS). Required for the full task-assignment dataset;
# without it gurobipy uses its size-limited license (fine for the mini dataset).
WLSACCESSID=
WLSSECRET=
LICENSEID=

# Task-assignment input files (defaults: projects/task_assignment/data/*.csv)
EMPLOYEE_PATH=
TASK_PATH=

# Discord webhook for progress messages (also set DISCORD: true in the config)
DISCORD_URL=
